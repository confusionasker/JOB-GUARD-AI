# ==============================================================================
# JobGuard AI - Environment Configuration
# ==============================================================================
PROJECT_NAME="JobGuard AI"
VERSION="1.0.0"
API_V1_STR="/api"

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>?charset=utf8mb4
# Example for XAMPP (default username 'root', blank password):
# DATABASE_URL="mysql+pymysql://root:@localhost:3306/jobguard_db?charset=utf8mb4"
# Example for local MySQL Server:
# ------------------------------------------------------------------------------
DATABASE_URL="mysql+pymysql://root:root1234@localhost:3306/jobguard_db?charset=utf8mb4"

# Fallback SQLite configuration (for environments without running MySQL service):
# DATABASE_URL="sqlite:///./jobguard.db"

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
SECRET_KEY="supersecret_jwt_key_jobguard_ai_development_only_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & Upload Limits
MAX_RESUME_SIZE_MB=10
ALLOWED_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Optional LLM Configuration (App runs 100% offline without LLM)
# ------------------------------------------------------------------------------
LLM_PROVIDER="fallback" # "fallback", "ollama", "openai", "gemini"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# Resume Match Score Weights (Must sum to 1.0)
# ------------------------------------------------------------------------------
WEIGHT_SKILLS=0.45
WEIGHT_EXPERIENCE=0.20
WEIGHT_SEMANTIC=0.15
WEIGHT_EDUCATION=0.10
WEIGHT_LOCATION=0.10
